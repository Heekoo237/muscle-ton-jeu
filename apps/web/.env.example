# Muscle Ton Jeu — variables d'environnement (apps/web)
# Copier en .env.local pour le développement, et renseigner dans Vercel pour la prod.
# Tant que ces variables sont absentes, l'app tourne en mode factice (en mémoire).

# ── Supabase ────────────────────────────────────────────────────────────
# Tableau de bord Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=          # SECRET — serveur uniquement, jamais exposé au navigateur
PUBLIC_SUPABASE_URL=                # même URL, exposée au client (auth)
PUBLIC_SUPABASE_ANON_KEY=           # clé anon (publique), pour l'authentification

# ── LLM (branchés en Session 8) ─────────────────────────────────────────
# GEMINI_API_KEY=                   # vision (lecture de ticket)
# ANTHROPIC_API_KEY=                # rédaction de l'analyse
