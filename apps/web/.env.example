# Muscle Ton Jeu — variables d'environnement (apps/web)
# Copier en .env.local pour le développement, et renseigner dans Vercel pour la prod.
# Tant que ces variables sont absentes, l'app tourne en mode factice (en mémoire).

# ── Supabase ────────────────────────────────────────────────────────────
# Tableau de bord Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=          # SECRET — serveur uniquement, jamais exposé au navigateur
PUBLIC_SUPABASE_URL=                # même URL, exposée au client (auth)
PUBLIC_SUPABASE_ANON_KEY=           # clé anon (publique), pour l'authentification

# ── LLM ─────────────────────────────────────────────────────────────────
# Vision (lecture de ticket) : modèle Claude rapide et bon marché (Haiku 4.5).
# Renseigne SOIT MTJ_VISION_KEY (dédiée), SOIT ANTHROPIC_API_KEY (partagée avec
# la rédaction). Sans clé, la vision reste factice (ticket type) — le reste du
# parcours se déroule quand même.
# MTJ_VISION_KEY=                   # clé Anthropic dédiée à la vision (facultatif)
# ANTHROPIC_API_KEY=                # clé Anthropic (vision + rédaction de l'analyse)

# ── Maintenance ─────────────────────────────────────────────────────────
# Secret du cron de purge des captures (> 30 jours). Doit correspondre à
# l'en-tête « Authorization: Bearer <secret> ». Vercel Cron l'ajoute
# automatiquement s'il est défini côté projet.
# CRON_SECRET=

# ── Support (contact utilisateur) ────────────────────────────────────────
# Numéro WhatsApp du support : indicatif pays inclus, CHIFFRES uniquement (le « + »
# et les espaces sont retirés de toute façon). Ex. Cameroun : 2376XXXXXXXX.
# Absent → les liens « Écris-nous » retombent sur /aide (jamais un lien mort).
# PUBLIC_SUPPORT_WHATSAPP=2376XXXXXXXX
# E-mail de contact affiché sur la page Confidentialité (facultatif).
# PUBLIC_SUPPORT_EMAIL=contact@exemple.com
