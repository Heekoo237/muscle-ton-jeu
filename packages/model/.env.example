# =========================================================================
# Modèle de configuration du pipeline (mtj-model).
# COPIE ce fichier en « .env » (même dossier) et remplis les valeurs.
# Le vrai « .env » n'est JAMAIS suivi par git (voir .gitignore) — ta clé y est
# en sécurité. Ne mets jamais de vraie clé dans CE fichier-ci (.env.example),
# qui, lui, est suivi par git.
# =========================================================================

# --- Fournisseur de données sportives (The Odds API) ---------------------
# Laisse "oddsapi" pour utiliser The Odds API.
MTJ_PROVIDER=oddsapi

# Ta clé The Odds API (obtenue sur the-odds-api.com). Colle-la après le "=".
# Exemple de forme : une longue suite de lettres et de chiffres.
MTJ_PROVIDER_KEY=

# --- Base de données Postgres (Supabase) ---------------------------------
# Chaîne de connexion du "pooler" Supabase (Project Settings → Database →
# Connection string → "Transaction pooler", port 6543). Colle-la après le "=".
# Forme : postgresql://postgres.<ref>:<mot_de_passe>@<hôte>:6543/postgres
MTJ_DATABASE_URL=
